# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
Primjeri/
Masters-thesis/

# Node
node_modules/

# Secrets & local config
.env
.env.*
!.env.example

# Data & models (large / regenerable)
data/raw/
# ...except the peer reference, which is 2.3 MB and is the one artefact the
# system cannot run without. Without it in the repo the coach works on one
# machine and nobody else can reproduce a single report.
!data/raw/out/
!data/raw/out/peers-e84.json

# Everything else the system loads by default. Without these a clone imports and
# then fails at the first run: the opening book and norms are needed for the
# report itself, the shelf for the answering agent, and the knowledge base for
# the explanations. 4.6 MB in total, all public-domain or generated here.
!data/openings/
!data/openings/**
!data/books/
!data/books/**
!data/knowledge.json
data/cache/
*.pgn.zst
*.bin
engines/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dendron local state
docs/.dendron.*
docs/notes/.dendron.cache.json
docs/build/

# Reference material (third-party texts, kept locally, not redistributed)
docs/pdf/

# Opening book (CC0, regenerable in under a second)
data/openings/

# The swarm's run history. Regenerable in the sense that it is a log of
# machine-local runs, and binary, so dump_run.py is the reviewable form.
data/runs.db*

# Fetched reference corpus: 5,917 games, reproducible via fetch_strong.py
data/raw/corpus-strong/

# Rebuilt peer references carrying the development claims (large, reproducible)
data/raw/out/peers-dev*.json
data/raw/out/peers-cost*.json
data/raw/out/peers-pawn*.json
data/raw/out/peers-strict*.json

# Search quota ledger: local spending record, not shared state
data/search-quota.json

# Knowledge base: drafted entries, regenerable, author-reviewed
data/knowledge.json

# Drafted knowledge entries: regenerable, author-reviewed
data/knowledge.json

# Public-domain books: 1.4 MB, reproducible from experiments/e64-books/fetch.py
data/books/

# Review-corpus evaluation cache: large, machine-local, rebuilt from the PGNs
data/cache/review.db
